# PostgreSQL connection string (Amazon EC2 local PostgreSQL or RDS in same VPC)
DATABASE_URL=postgresql+psycopg2://braille_user:BrailleSecurePass2026!@127.0.0.1:5432/braille_saas

# JWT configuration (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_64_char_random_hex_secret_key_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated allowed CORS origins (or * for controlled lab testing)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
