[Unit]
Description=BrailleCloud SaaS FastAPI Backend (Gunicorn + Uvicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/braille-saas/backend
EnvironmentFile=/opt/braille-saas/backend/.env
ExecStart=/opt/braille-saas/backend/venv/bin/gunicorn \
    -k uvicorn.workers.UvicornWorker \
    -w 4 \
    -b 127.0.0.1:8000 \
    --timeout 30 \
    --keep-alive 5 \
    main:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
