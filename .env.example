# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ESP32_SECRET_TOKEN: Token secreto para autenticar peticiones en el header HTTP X-ESP32-Token
ESP32_SECRET_TOKEN="MI_TOKEN_SECRETO_123"

# ALLOWED_IP: (Opcional) Dirección IP permitida para restringir peticiones. Si está vacío, se permiten todas.
ALLOWED_IP=""

NGROK_AUTHTOKEN=""
