# Base de datos PostgreSQL (Backend FastAPI)
DATABASE_URL=postgresql+psycopg2://braille_user:CHANGE_ME@127.0.0.1:5432/braille_saas

# Seguridad JWT (generar con: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_HEX
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Orígenes CORS permitidos separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcional: URL base de la API para el frontend cuando se ejecuta fuera del mismo origen
VITE_API_BASE_URL=